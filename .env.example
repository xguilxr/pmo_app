# ============================================
# PMO Platform - Environment Variables
# ============================================
# Copy this file as .env and fill in the values
# NEVER commit the .env file to the repository

# --- Environment ---
APP_ENV=development          # development | staging | production
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/pmo_db
DATABASE_POOL_SIZE=5

# --- Server ---
HOST=0.0.0.0
PORT=8080

# --- Authentication ---
JWT_SECRET=change-me-to-a-random-jwt-secret
JWT_EXPIRATION_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30

# --- Email (for password recovery) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@pmo-platform.com

# --- Railway (if deployed on Railway) ---
# RAILWAY_STATIC_URL=
# RAILWAY_GIT_COMMIT_SHA=

# --- AI / Local Model (future) ---
# LOCAL_MODEL_PATH=
# LOCAL_MODEL_NAME=
# AI_ENABLED=false

# --- Internationalization ---
DEFAULT_LOCALE=es
SUPPORTED_LOCALES=es,en

# --- File Uploads ---
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=pdf,xlsx,xls,docx,doc,pptx,ppt,png,jpg,jpeg
