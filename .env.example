# ============================================
# PMO Platform - Environment Variables
# ============================================
# Copy this file as .env and fill in the values
# NEVER commit the .env file to the repository

# --- Environment ---
APP_ENV=development          # development | staging | production
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret

# --- Database ---
# MySQL (default for HostGator/cPanel):
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/pmo_db?charset=utf8mb4
# PostgreSQL (alternative):
# DATABASE_URL=postgresql://user:password@localhost:5432/pmo_db
DATABASE_POOL_SIZE=5

# --- Server ---
HOST=0.0.0.0
PORT=8080

# --- Multi-Tenant ---
DOMAIN=yourplatform.com           # Base domain for subdomain routing
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Authentication ---
JWT_SECRET=change-me-to-a-random-jwt-secret
JWT_EXPIRATION_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30

# --- Email (for password recovery) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@pmo-platform.com

# --- Railway (if deployed on Railway) ---
# RAILWAY_STATIC_URL=
# RAILWAY_GIT_COMMIT_SHA=

# --- AI Engine ---
AI_ENABLED=true
AI_DEFAULT_ENGINE=ollama              # ollama | claude_api | disabled

# Ollama (local model)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b              # qwen2.5:7b | llama3.1:8b | mistral:7b
OLLAMA_TIMEOUT_SECONDS=120

# Claude API (fallback / premium)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=4096

# AI Parameters
AI_TEMPERATURE=0.3
AI_MAX_INPUT_TOKENS=15000
AI_OUTPUT_LANGUAGE=es                 # es | en

# --- MS Project Integration ---
MPXJ_ENABLED=true
MAX_MPP_UPLOAD_SIZE_MB=50

# --- Internationalization ---
DEFAULT_LOCALE=es
SUPPORTED_LOCALES=es,en

# --- File Uploads ---
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=pdf,xlsx,xls,docx,doc,pptx,ppt,png,jpg,jpeg,txt,srt,mpp,xml
