# ============================================
# Docker Compose Environment Variables
# ============================================
# Copy as .env inside docker/ folder before running docker compose

# Database
DB_PASSWORD=secreto

# Security (CHANGE THESE IN PRODUCTION)
SECRET_KEY=change-me-to-a-random-secret
JWT_SECRET=change-me-to-a-random-jwt-secret

# Environment
APP_ENV=production
DEBUG=false

# AI (optional)
AI_ENABLED=false
AI_DEFAULT_ENGINE=ollama
ANTHROPIC_API_KEY=
