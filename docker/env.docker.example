# ============================================
# Docker Compose Environment Variables
# ============================================
# Copy as .env inside docker/ folder before running docker compose

# Database (generate a strong random value)
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Security — REQUIRED. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
JWT_SECRET=

# Environment
APP_ENV=production
DEBUG=false

# AI (optional)
AI_ENABLED=false
AI_DEFAULT_ENGINE=ollama
ANTHROPIC_API_KEY=
